# ---- build outputs (generated by build_macos.sh) ----
/build/
/firmware/
/release/
/misc/

# Downloaded toolchain (setup_toolchain.sh)
/third_party/toolchain/

# ---- python ----
__pycache__/
*.pyc

# ---- host tool binaries (sources stay tracked) ----
/tools/desc_test_cdc
/tools/ep0_boundary_test
/tools/getdesc
/tools/hidlog

# ---- stray compiler outputs at the project root ----
# Path-scoped on purpose: the vendored SDK keeps prebuilt *.a/*.bin
# (Bluetooth/USB libraries, boot2/partition images) that MUST be tracked.
/*.i
/*.d
/*.o
/*.log

# ---- editors / OS ----
.DS_Store
*.code-workspace
.vscode/
